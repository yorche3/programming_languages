with "config/training_config.gpr";
project Training is

   for Library_Name use "Training";
   for Library_Version use Project'Library_Name & ".so." & Training_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/", "src/utils/", "src/basis/");
   for Object_Dir use "obj/" & Training_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TRAINING_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Training_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Training;
