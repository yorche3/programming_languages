with "config/training_config.gpr";
project Test is
   for Languages use ("Ada");
   for Source_Dirs use ("test/", "src/", "test/suites/", "test/suites/tests/", "src/utils/", "src/basis/");
   for Main use ("test_runner.adb");
   for Exec_Dir use ".";
   for Object_Dir use "obj";

   package Linker is
      for Default_Switches ("ada") use ("-g");
   end Linker;

   package Binder is
      for Default_Switches ("ada") use ("-E", "-static");
   end Binder;

   package Compiler is
      for Default_Switches ("ada") use
        ("-g", "-gnatQ", "-O1", "-gnatf", "-gnato",
         "-gnatwa.Xe", "-gnaty", "-gnat05");
   end Compiler;

end Test;