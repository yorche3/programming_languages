project('@MODULE@', ['c', 'vala'],
  version : '0.1')

dependencies = [
    dependency('glib-2.0'),
    dependency('gobject-2.0'),
]

# These arguments are only used to build the shared library
# not the executables that use the library.
shlib = shared_library('foo', '@MODULE@.vala',
               dependencies: dependencies,
               install: true,
               install_dir: [true, true, true])

test_exe = executable('@MODULE@_test', '@MODULE@_test.vala', dependencies : dependencies,
  link_with : shlib)
test('@MODULE@', test_exe)

# Make this library usable as a Meson subproject.
@MODULE@_dep = declare_dependency(
  include_directories: include_directories('.'),
  link_with : shlib)
